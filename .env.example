# Sāttvic Mind – environment configuration
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# ── LLM Provider ───────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama
SATTVIC_LLM_PROVIDER=openai

# Model override (optional – each provider has a sensible default)
# SATTVIC_MODEL=gpt-4o-mini

# ── API Keys ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local) ──────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# SATTVIC_MODEL=llama3

# ── Trace output ────────────────────────────────────────────────────────────
# Directory where JSONL trace files are written (default: traces/)
# SATTVIC_TRACE_DIR=traces
